.page {
  min-height: 100vh;
  background: linear-gradient(160deg, #1989fa 0%, #47a7ff 50%, #79c0ff 100%);
  padding: 0 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header {
  padding-top: 120rpx;
  text-align: center;
  margin-bottom: 60rpx;
}

.logo {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
}

.app-desc {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
}

.card {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 40rpx;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.1);
}

.card-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 40rpx;
}

.input-group {
  margin-bottom: 36rpx;
}

.input-wrap {
  display: flex;
  align-items: center;
  background: #f5f7fa;
  border-radius: 16rpx;
  padding: 0 28rpx;
  height: 92rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid transparent;
}

.input-wrap:last-child {
  margin-bottom: 0;
}

.input-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  height: 92rpx;
}

.btn-primary {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: linear-gradient(135deg, #ff7849, #ff5e62);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
  padding: 0;
  text-align: center;
}

.btn-primary::after {
  border: none;
}

.switch-row {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 32rpx;
}

.switch-text {
  font-size: 26rpx;
  color: #999;
}

.switch-link {
  font-size: 26rpx;
  color: #1989fa;
  font-weight: 500;
  margin-left: 8rpx;
}

.divider {
  display: flex;
  align-items: center;
  width: 100%;
  margin: 56rpx 0 40rpx;
}

.divider-line {
  flex: 1;
  height: 1px;
  background: rgba(255,255,255,0.35);
}

.divider-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  padding: 0 24rpx;
}

.other-login {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.wx-icon {
  width: 96rpx;
  height: 96rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.wx-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
}
