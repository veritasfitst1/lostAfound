.user-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #1989fa 0%, #5cadff 100%);
  border-radius: 24rpx;
  padding: 48rpx;
  margin-bottom: 24rpx;
}

.avatar-wrap {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin-right: 32rpx;
  flex-shrink: 0;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #fff;
  display: block;
}

.avatar-hint {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 40rpx;
  line-height: 40rpx;
  font-size: 20rpx;
  color: #fff;
  text-align: center;
  background: rgba(0, 0, 0, 0.45);
  border-radius: 0 0 60rpx 60rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

.user-meta {
  font-size: 24rpx;
  color: rgba(255,255,255,0.9);
  margin-top: 6rpx;
}

.user-id {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 8rpx;
}

.menu-disabled {
  opacity: 0.65;
}

.text-muted {
  color: #999;
}

.menu-section {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.menu-item {
  padding: 32rpx 32rpx;
  font-size: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.arrow {
  color: #999;
  font-size: 36rpx;
}

.logout-btn {
  text-align: center;
  color: #ed6a0c;
  font-size: 30rpx;
  padding: 32rpx;
}
