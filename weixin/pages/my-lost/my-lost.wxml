<view class="container">
  <view class="item-card" wx:for="{{items}}" wx:key="id">
    <view class="item-main flex" data-id="{{item.id}}" bindtap="toDetail">
      <image class="item-img" src="{{item.images && item.images[0] || '/assets/icons/home.png'}}" mode="aspectFill"/>
      <view class="item-info">
        <view class="item-title">{{item.title}}</view>
        <view class="item-meta text-muted">{{item.categoryName}} · {{item.location || '-'}}</view>
        <view class="status status-{{item.status}}">{{item.status === 0 ? '寻找中' : item.status === 1 ? '已找回' : item.status === 2 ? '已撤销' : '已过期'}}</view>
      </view>
    </view>
    <view class="btn-group" wx:if="{{item.status === 0}}">
      <view class="btn-found" data-id="{{item.id}}" bindtap="onFound">已找回</view>
      <view class="btn-revoke" data-id="{{item.id}}" bindtap="onRevoke">撤销</view>
    </view>
    <view class="btn-undo" wx:if="{{item.status === 2}}" data-id="{{item.id}}" bindtap="onUndo">取消撤销</view>
  </view>
  <view class="empty-state" wx:if="{{items.length === 0}}">
    <view class="empty-icon-wrap">
      <text class="empty-icon">🔍</text>
    </view>
    <view class="empty-title">暂无失物发布</view>
    <view class="empty-desc">你还没有发布过失物信息</view>
    <view class="empty-hint">可在首页发布，让更多人帮你一起找</view>
  </view>
</view>
