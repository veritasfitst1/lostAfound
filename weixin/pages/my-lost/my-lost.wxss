.item-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.item-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
}

.item-info {
  flex: 1;
}

.item-title {
  font-size: 30rpx;
  font-weight: 500;
}

.item-meta {
  font-size: 24rpx;
  margin-top: 8rpx;
}

.status { font-size: 24rpx; margin-top: 8rpx; }
.status-0 { color: #1989fa; }
.status-1 { color: #07c160; }
.status-2 { color: #999; }
.status-3 { color: #ed6a0c; }

.btn-revoke {
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  color: #ed6a0c;
  background: #fff3f0;
  border-radius: 16rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 48rpx 80rpx;
}

.empty-icon-wrap {
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #e8f3ff 0%, #f0f7ff 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(25, 137, 250, 0.08);
}

.empty-icon {
  font-size: 80rpx;
  line-height: 1;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  letter-spacing: 1rpx;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
  text-align: center;
  max-width: 520rpx;
}
