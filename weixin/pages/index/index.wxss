.page-index {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

.index-header {
  flex-shrink: 0;
  position: relative;
  z-index: 10;
  background: #f5f6fa;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
}

.search-left {
  flex: 1;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 32rpx;
  padding: 0 24rpx;
  height: 76rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.search-action {
  width: 56rpx;
  height: 56rpx;
  margin-left: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-camera {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.camera-icon {
  width: 34rpx;
  height: 34rpx;
  opacity: 0.8;
}

.ai-search-hint {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #666;
}

.ai-tag {
  background: #1989fa;
  color: #fff;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
}

.ai-text {
  flex: 1;
}

.ai-clear {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: #f5f6fa;
}

.filter-bar {
  padding: 16rpx 0;
  font-size: 26rpx;
}

.filter-item {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  background: #fff;
}

.filter-item.active {
  background: #1989fa;
  color: #fff;
}

.filter-cats {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-bottom: 16rpx;
}

.cat-item {
  padding: 12rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  font-size: 26rpx;
}

.cat-item.active {
  background: #1989fa;
  color: #fff;
}

.item-list {
  flex: 1;
  min-height: 0;
  height: 0;
  background: #f5f6fa;
}

.item-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.item-img {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  padding: 24rpx;
  position: relative;
}

.item-title {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.item-meta {
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.item-time {
  font-size: 22rpx;
}

.item-tag {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.item-tag.lost {
  background: #fff3f0;
  color: #ed6a0c;
}

.item-tag.found {
  background: #e6f7ff;
  color: #1989fa;
}

.loading-tip, .empty-tip {
  text-align: center;
  padding: 48rpx;
  font-size: 26rpx;
}
