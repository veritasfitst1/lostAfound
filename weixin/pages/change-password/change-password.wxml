<view class="container">
  <view class="card">
    <view class="input-wrap">
      <text class="label">原密码</text>
      <input class="input" password placeholder="请输入当前登录密码" value="{{oldPassword}}" bindinput="onOldPasswordInput"/>
    </view>
    <view class="input-wrap">
      <text class="label">新密码</text>
      <input class="input" password placeholder="6-32位新密码" value="{{newPassword}}" bindinput="onNewPasswordInput"/>
    </view>
    <view class="input-wrap">
      <text class="label">确认新密码</text>
      <input class="input" password placeholder="再次输入新密码" value="{{confirmPassword}}" bindinput="onConfirmPasswordInput"/>
    </view>
    <button class="submit-btn" bindtap="onSubmit">确认修改</button>
  </view>
</view>
