.item-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.item-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
}

.item-info { flex: 1; }

.item-title { font-size: 30rpx; font-weight: 500; }
.item-meta { font-size: 24rpx; margin-top: 8rpx; }
.status { font-size: 24rpx; margin-top: 8rpx; }
.status-0 { color: #1989fa; }
.status-1 { color: #07c160; }
.status-2 { color: #999; }
.status-3 { color: #ed6a0c; }

.btn-group {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  flex-shrink: 0;
}

.btn-found,
.btn-revoke,
.btn-undo {
  margin: 0;
  padding: 14rpx 0;
  font-size: 26rpx;
  line-height: 1.4;
  border-radius: 12rpx;
  width: 130rpx;
  text-align: center;
}

.btn-found {
  color: #07c160;
  background: #e8f8ee;
}

.btn-revoke {
  color: #ed6a0c;
  background: #fff3f0;
}

.btn-undo {
  color: #1989fa;
  background: #e8f3ff;
  flex-shrink: 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 48rpx 80rpx;
}

.empty-icon-wrap {
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #e6f7ff 0%, #f0fbff 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(25, 137, 250, 0.08);
}

.empty-icon {
  font-size: 80rpx;
  line-height: 1;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  letter-spacing: 1rpx;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
  text-align: center;
  max-width: 520rpx;
}
